#!/bin/bash

## Copyright (C) 2019 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## usage:
## sudo client=1 anon-server-to-client-install

#set -x

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

## anon-gw-anonymizer-config Depends on helper-scripts.
##
## 'has' is a FUNCTION defined here, not an executable. This file called it at
## the 'has touch tee mkdir ...' preflight without ever sourcing the helper, so
## every invocation died with 'has: command not found' before installing the
## authorization. Its siblings anon-auth-autogen, anon-dns, onion-grater-add and
## onion-grater-remove all source it; this one was missed.
# shellcheck source=../../../../kicksecure/helper-scripts/usr/libexec/helper-scripts/has.sh
## Sibling repo: absent in an isolated CI checkout, so shellcheck cannot
## follow it there. The source= path above still documents where it lives.
# shellcheck disable=SC1091
source /usr/libexec/helper-scripts/has.sh

error_handler() {
   local exit_code="$?"
   printf '%s\n' "ERROR: exit_code: ${exit_code} | BASH_COMMAND: ${BASH_COMMAND}"
   exit 1
}

trap error_handler ERR

SCRIPTNAME="$(basename "${BASH_SOURCE[0]}")"

if [ "$(id -u)" != "0" ]; then
    printf '%s\n' "ERROR: This must be run as root (sudo)!"
    printf '%s\n' "INFO: You can start ${SCRIPTNAME} by entering..."
    printf '%s\n' "      sudo ${SCRIPTNAME}"
    exit 1
fi

torconfdir="${torconfdir:-/usr/local/etc/torrc.d}"

torconffile="${torconffile:-${torconfdir}/43_clientonionauthdir.conf}"

torunit="${torunit:-tor@default}"

unitaction="${unitaction:-reload}"
unitruntest="${unitruntest:-is-active}"

unittool="${unittool:-systemctl}"

unitcmd="${unitcmd:-${unittool} ${unitaction} ${torunit}}"

unitruntestcmd="${unitruntestcmd:-${unittool} ${unitruntest} ${torunit}}"

## '${SUDO_USER:-}', not '${SUDO_USER}': a nested default protects only the
## OUTER name. SUDO_USER is unset when this runs as root directly rather than
## through sudo, and the inner expansion aborted even though the outer one had
## a fallback.
user_name="${user_name:-${SUDO_USER:-}}"

tor_user="${tor_user:-debian-tor}"
tor_group="${tor_group:-debian-tor}"

client="${client:-1}"

tor_dir="${tor_dir:-/var/lib/tor}"

client_onion_auth_dir="${client_onion_auth_dir:-${tor_dir}/authdir}"

auth_private_file_name="${auth_private_file_name:-${client}.auth_private}"

sourcefile="${sourcefile:-/home/${user_name}/${auth_private_file_name}}"

auth_private_file_full_target_path="${auth_private_file_full_target_path:-${client_onion_auth_dir}/${auth_private_file_name}}"

client_onion_auth_full_path="${client_onion_auth_full_path:-${client_onion_auth_dir}/${auth_private_file_name}}"

tor_user_sudo="${tor_user_sudo:-sudo --non-interactive -u ${tor_user}}"

has touch tee mkdir chmod chown cp sudo id groups "${unittool}" sleep

id "${tor_user}" >/dev/null
groups "${tor_group}" >/dev/null

if ! ${unitruntestcmd} &>/dev/null ; then
   printf '%s\n' "ERROR: Tor is not running. Start Tor first."
   exit 1
fi

if ! test -r "${sourcefile}" ; then
   printf '%s\n' "ERROR: sourcefile '${sourcefile}' does not exist!" >&2
   exit 1
fi

if ! test -d "${tor_dir}" ; then
   printf '%s\n' "ERROR: tor_dir '${tor_dir}' does not exist!" >&2
   exit 1
fi

mkdir -p "${client_onion_auth_dir}"
chown "${tor_user}:${tor_group}" "${client_onion_auth_dir}"

## Keys installed by an earlier run kept whatever mode they were copied with.
## Tighten them so an already deployed key stops being exposed, instead of
## staying world-readable until it happens to be regenerated. Runs before the
## copy below so it only ever sees pre-existing keys; the newly installed key
## is chmod'ed separately, keeping the two paths independently testable.
shopt -s nullglob
for existing_auth_private_file in "${client_onion_auth_dir}"/*.auth_private ; do
   chmod 0600 -- "${existing_auth_private_file}"
done
shopt -u nullglob

cp "${sourcefile}" "${auth_private_file_full_target_path}"
chown "${tor_user}:${tor_group}" "${auth_private_file_full_target_path}"

## 'cp' preserves the source mode, and the sourcefile normally arrives in the
## user's home folder world-readable, so the mode is set explicitly here.
chmod 0600 -- "${auth_private_file_full_target_path}"

printf '%s\n' "INFO: Installed \".auth_private\" file (private key) '${sourcefile}' to '${auth_private_file_full_target_path}'."

test -d "${torconfdir}"
safe-rm -f -- "${torconffile}"
touch "${torconffile}"

printf '%s\n' "\
# This file is generated by by $0
# User configuration should go to /usr/local/etc/torrc.d/50_user.conf, not here.
# However, deleting this file will be fine since a new plain file will be generated the next time you run ${SCRIPTNAME}

# Also Whonix package anon-gw-anonymizer-config already ships file
# /etc/torrc.d/65_gateway.conf which also includes
# ClientOnionAuthDir /var/lib/tor/authdir
ClientOnionAuthDir ${client_onion_auth_dir}
" | tee "${torconffile}" >/dev/null

printf '%s\n' "INFO: Created torconffile '${torconffile}'."

printf '%s\n' "INFO: Reloading Tor to activate \".auth_private\" file (private key)."

## Reload Tor to so Tor will load client_authorization_full_path.
## by default:
## systemctl reload tor@default
${unitcmd}

printf '%s\n' "INFO: Success."
